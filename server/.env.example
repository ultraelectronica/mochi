PORT=3000
# Optional. Bind address for the server. Use 0.0.0.0 to listen on all interfaces (default).
HOST=0.0.0.0
# Optional. When set, all HTTP routes except GET /health and all WebSocket connections
# require: Authorization: Bearer <same value>
MOCHI_API_KEY=

# Local TinyLlama inference via llama.cpp. The Node server auto-spawns
# `llama-server` when LLAMA_SPAWN=1 and the binary + model exist, so a single
# `pnpm dev` brings up the whole backend. Set LLAMA_SPAWN=0 to manage it yourself.
LLAMA_URL=http://127.0.0.1:8080
LLAMA_SPAWN=1
LLAMA_BINARY=~/llama.cpp/build/bin/llama-server
LLAMA_MODEL=~/models/tinyllama-1.1b-chat-v1.0.Q4_K_M.gguf
LLAMA_HOST=127.0.0.1
LLAMA_PORT=8080
LLAMA_CTX_SIZE=2048
LLAMA_THREADS=0

# Primary AI backend (OpenRouter, OpenAI-compatible).
OPENROUTER_API_KEY=your_key_here
OPENROUTER_MODEL=openrouter/owl-alpha
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Cloud fallback used when OpenRouter is down or unreachable.
DEEPSEEK_API_KEY=your_key_here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

MOOD_DECAY_HOURS=12
XP_PER_CHAT=10
XP_PER_CHECKIN=5
XP_PER_TAP=2
SESSION_MAX_AGE_DAYS=30
